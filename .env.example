# The app answers the ten curated journeys with no configuration at all.
# Set one of these to let the planner handle long-tail questions too.
# Keys are read server-side only, in app/api/ask/route.ts.
#
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_URL=
#
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
